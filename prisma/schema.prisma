generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  super_admin
  admin
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum FieldType {
  text
  email
  phone
  select
  number
  brand_models
}

enum TournamentStatus {
  pending
  active
  finished
}

enum MatchStatus {
  waiting
  playing
  finished
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  description String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brands  Brand[]
  trivias Trivia[]
  users   User[]
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  name      String
  logoUrl   String?
  models    Json     @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trivias Trivia[]
  sprites VehicleSprite[]

  @@unique([companyId, name])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(admin)
  companyId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company         Company?         @relation(fields: [companyId], references: [id])
  trivias         Trivia[]
  assets          Asset[]
  ownedTemplates  TriviaTemplate[] @relation("TemplateOwner")
  sharedTemplates TemplateShare[]  @relation("SharedWith")
  tournaments     Tournament[]
}

model Trivia {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  slug               String    @unique
  logoUrl            String?
  companyId          String?
  primaryColor       String    @default("#003087")
  secondaryColor     String    @default("#002060")
  accentColor        String    @default("#FFD700")
  backgroundColor    String    @default("#F8FAFC")
  textColor          String    @default("#1A1A2E")
  isActive           Boolean   @default(true)
  isPublic           Boolean   @default(true)
  showLeaderboard    Boolean   @default(true)
  startDate          DateTime?
  endDate            DateTime?
  maxPlaysPerUser    Int       @default(1)
  /// Exige cuenta de jugador para participar. Se justifica por el premio:
  /// no se le puede entregar un premio a una cookie, y el límite de jugadas
  /// solo es real si hay una cuenta detrás.
  requiresAccount    Boolean   @default(false)
  gameInstructions   String?
  termsAndConditions String?
  heroImageUrl       String?
  heroImageSettings  Json? // { x: number, y: number, zoom: number, height: number }
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  creator      User          @relation(fields: [createdBy], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])
  brands       Brand[]
  questions    Question[]
  formFields   FormField[]
  leads        Lead[]
  gameSessions GameSession[]
  prizes       Prize[]
  flyers       TriviaFlyer[]
  pageViews    PageView[]
  tournaments  Tournament[]
}

model Question {
  id            String   @id @default(cuid())
  triviaId      String
  question      String
  options       Json
  correctAnswer Int
  points        Int      @default(100)
  timeLimit     Int      @default(30)
  orderIndex    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trivia Trivia @relation(fields: [triviaId], references: [id], onDelete: Cascade)

  @@index([triviaId, orderIndex])
}

model FormField {
  id          String    @id @default(cuid())
  triviaId    String
  fieldName   String
  fieldLabel  String
  fieldType   FieldType @default(text)
  isRequired  Boolean   @default(true)
  options     Json?
  placeholder String?
  orderIndex  Int

  trivia Trivia @relation(fields: [triviaId], references: [id], onDelete: Cascade)

  @@index([triviaId])
}

model Lead {
  id          String   @id @default(cuid())
  triviaId    String
  /// Presente cuando la trivia exigió cuenta, o cuando quien jugó tenía
  /// sesión iniciada. Nulo en las partidas anónimas históricas.
  playerId    String?
  sessionId   String
  formData    Json
  score       Int
  maxScore    Int
  answers     Json
  ipAddress   String?
  userAgent   String?
  completedAt DateTime @default(now())

  trivia Trivia  @relation(fields: [triviaId], references: [id])
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([triviaId, completedAt])
  @@index([playerId])
}

model GameSession {
  id                String    @id @default(cuid())
  triviaId          String
  sessionIdentifier String
  playCount         Int       @default(0)
  hasCompleted      Boolean   @default(false)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  trivia Trivia @relation(fields: [triviaId], references: [id])

  @@unique([triviaId, sessionIdentifier])
  @@index([sessionIdentifier])
}

model Asset {
  id         String   @id @default(cuid())
  name       String
  url        String
  fileType   String
  sizeBytes  Int
  uploadedBy String
  companyId  String?
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploadedBy], references: [id])
}

/// Premio de un juego. Cuelga de una trivia o de un evento de predicción:
/// exactamente uno de los dos, nunca los dos ni ninguno.
model Prize {
  id                String   @id @default(cuid())
  triviaId          String?
  predictionEventId String?
  name              String
  description       String?
  imageUrl          String?
  position          Int // 1=primero, 2=segundo, etc.
  createdAt         DateTime @default(now())

  trivia          Trivia?          @relation(fields: [triviaId], references: [id], onDelete: Cascade)
  predictionEvent PredictionEvent? @relation(fields: [predictionEventId], references: [id], onDelete: Cascade)

  @@index([triviaId])
  @@index([predictionEventId])
}

model TriviaFlyer {
  id        String   @id @default(cuid())
  triviaId  String
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  trivia Trivia @relation(fields: [triviaId], references: [id], onDelete: Cascade)

  @@index([triviaId])
}

// Analytics - tracks page visits and session events
model PageView {
  id        String   @id @default(cuid())
  triviaId  String?
  path      String
  sessionId String?
  ipAddress String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  trivia Trivia? @relation(fields: [triviaId], references: [id])

  @@index([triviaId, createdAt])
  @@index([path, createdAt])
}

model TriviaTemplate {
  id              String   @id @default(cuid())
  title           String
  description     String?
  logoUrl         String?
  primaryColor    String   @default("#003087")
  secondaryColor  String   @default("#002060")
  accentColor     String   @default("#FFD700")
  backgroundColor String   @default("#F8FAFC")
  textColor       String   @default("#1A1A2E")
  questions       Json
  formFields      Json
  ownerId         String
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner  User            @relation("TemplateOwner", fields: [ownerId], references: [id])
  shares TemplateShare[]
}

model TemplateShare {
  id           String   @id @default(cuid())
  templateId   String
  sharedWithId String
  createdAt    DateTime @default(now())

  template   TriviaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sharedWith User           @relation("SharedWith", fields: [sharedWithId], references: [id])

  @@unique([templateId, sharedWithId])
}

// ─── Football Module ────────────────────────────────────────────────────────

model VehicleSprite {
  id          String   @id @default(cuid())
  brandId     String?
  modelName   String?
  spriteUrl   String
  isGeneric   Boolean  @default(false)
  genericType String? // "sedan" | "truck" | "suv"
  createdAt   DateTime @default(now())

  brand        Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  participants TournamentParticipant[]

  @@index([brandId])
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  triviaId    String?
  status      TournamentStatus @default(pending)
  maxPlayers  Int              @default(16)
  prizeConfig Json             @default("{}") // { "1": "Premio 1", "2": "Premio 2" }
  gameConfig  Json             @default("{}") // { duration: 90, ballSpeed: 1, ... }
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  creator      User                    @relation(fields: [createdBy], references: [id])
  trivia       Trivia?                 @relation(fields: [triviaId], references: [id], onDelete: SetNull)
  participants TournamentParticipant[]
  matches      TournamentMatch[]

  @@index([status])
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  cedula       String
  playerName   String
  vehicleId    String?
  seed         Int?
  createdAt    DateTime @default(now())

  tournament  Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  vehicle     VehicleSprite?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  matchesAsP1 TournamentMatch[] @relation("MatchPlayer1")
  matchesAsP2 TournamentMatch[] @relation("MatchPlayer2")

  @@unique([tournamentId, cedula])
  @@index([tournamentId])
}

model TournamentMatch {
  id            String      @id @default(cuid())
  tournamentId  String
  player1Id     String
  player2Id     String
  round         Int         @default(1)
  scoreP1       Int         @default(0)
  scoreP2       Int         @default(0)
  status        MatchStatus @default(waiting)
  roomCode      String      @unique @default(cuid())
  winnerId      String?
  scheduledAt   DateTime? // admin programa fecha/hora del partido
  roomEnabledAt DateTime? // admin habilita la sala (jugadores pueden conectar)
  playedAt      DateTime?
  createdAt     DateTime    @default(now())

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    TournamentParticipant @relation("MatchPlayer1", fields: [player1Id], references: [id])
  player2    TournamentParticipant @relation("MatchPlayer2", fields: [player2Id], references: [id])

  @@index([tournamentId, round])
  @@index([roomCode])
}

// ─── Audit log ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  entityType String // "Trivia" | "Company" | "Brand" | "User" | "Tournament" | "PlatformSettings"
  entityId   String
  entityName String? // Human-readable identifier (title, name, email…)
  action     AuditAction
  userId     String
  userName   String
  userEmail  String
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─── Global platform settings (singleton pattern - only one record) ─────────

model PlatformSettings {
  id                String   @id @default("singleton")
  platformTerms     String? // Terms of use for admin users
  privacyPolicy     String?
  heroImageUrl      String?
  heroImageSettings Json? // { zoom: number, x: number, y: number, height: number }
  updatedAt         DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Módulo de predicciones
//
// Motor genérico de mercados: no menciona rally en ninguna parte. Un tramo es un
// Segment, un piloto un Contender y lo que se predice un Market. El mismo motor
// corre otros eventos cambiando datos, no código.
// ─────────────────────────────────────────────────────────────────────────────

enum EventStatus {
  draft
  open
  live
  closed
  settled
}

enum MarketType {
  single_pick
  ordered_pick
  multi_pick
  numeric
}

enum PlayerTokenType {
  email_verification
  password_reset
}

/// Cuenta de cliente. Tabla separada de `User` a propósito: los administradores
/// nunca deben compartir tabla con los jugadores.
model Player {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  fullName        String
  phone           String
  cedula          String?   @unique
  emailVerifiedAt DateTime?
  acceptedTermsAt DateTime?
  termsVersion    String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  predictions Prediction[]
  tokens      PlayerToken[]
  leads       Lead[]

  @@index([createdAt])
}

/// Tokens de verificación de correo y recuperación de contraseña.
/// Se guarda el hash, nunca el token en claro.
model PlayerToken {
  id        String          @id @default(cuid())
  playerId  String
  tokenHash String          @unique
  type      PlayerTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, type])
}

model PredictionEvent {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String?
  status          EventStatus @default(draft)
  externalRef     String?
  opensAt         DateTime?
  closesAt        DateTime?
  companyId       String?
  brandId         String?
  heroImageUrl    String?
  primaryColor    String      @default("#005CA8")
  secondaryColor  String      @default("#004071")
  /// Alineado con Trivia.accentColor: mismo campo, mismo default, misma paleta de referencia.
  accentColor     String      @default("#FFD700")
  /// Alineado con Trivia.backgroundColor.
  backgroundColor String      @default("#F8FAFC")
  /// Alineado con Trivia.textColor.
  textColor       String      @default("#1A1A2E")
  rules           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  segments   Segment[]
  contenders Contender[]
  markets    Market[]
  prizes     Prize[]

  @@index([status])
}

/// Subunidad con cierre propio: un tramo, una fecha, una carrera.
model Segment {
  id          String    @id @default(cuid())
  eventId     String
  code        String
  name        String
  orderIndex  Int
  distanceKm  Float?
  startsAt    DateTime?
  /// Editable: en rally se reprograman y cancelan tramos con frecuencia.
  locksAt     DateTime
  isCancelled Boolean   @default(false)

  event   PredictionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  markets Market[]

  @@unique([eventId, code])
  @@index([eventId, orderIndex])
}

/// El roster elegible. Provee el espacio de respuestas de los mercados.
model Contender {
  id          String  @id @default(cuid())
  eventId     String
  externalRef String?
  number      String?
  name        String
  subtitle    String?
  teamName    String?
  category    String?
  imageUrl    String?
  isFeatured  Boolean @default(false)
  isActive    Boolean @default(true)
  orderIndex  Int     @default(0)

  event PredictionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, number])
  @@index([eventId, orderIndex])
}

/// La pregunta a predecir. `segmentId` nulo = mercado de evento (podio final).
model Market {
  id         String     @id @default(cuid())
  eventId    String
  segmentId  String?
  type       MarketType
  title      String
  orderIndex Int        @default(0)
  /// Parámetros del evaluador: points, exactAllPoints, misplacedPoints, positions.
  config     Json       @default("{}")
  /// Momento de cierre. Se hereda del segmento y se puede pisar.
  locksAt    DateTime

  event       PredictionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  segment     Segment?        @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  predictions Prediction[]
  resolution  Resolution?

  @@index([eventId, locksAt])
  @@index([segmentId])
}

model Prediction {
  id            String    @id @default(cuid())
  marketId      String
  playerId      String
  /// Forma según MarketType: string, string[] o number.
  value         Json
  /// Null mientras el mercado no esté resuelto.
  pointsAwarded Int?
  scoredAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([marketId, playerId])
  @@index([playerId])
}

/// El resultado real. Editable: los tiempos de rally se revisan por
/// penalizaciones y al cambiar hay que repuntuar el mercado entero desde cero.
model Resolution {
  id        String    @id @default(cuid())
  marketId  String    @unique
  value     Json
  source    String    @default("manual")
  enteredBy String?
  revisedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
}
